    {
        "id": "tpl_dashboard",
        "type": "template",
        "z": "tab_iot_lengkap",
        "name": "HTML Dashboard",
        "field": "payload",
        "fieldType": "msg",
        "format": "html",
        "syntax": "plain",
        "template": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>IoT Dashboard - Real-Time WebSocket & REST API</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }\n        body { background: linear-gradient(135deg, #667eea, #764ba2); min-height: 100vh; padding: 20px; color: #333; }\n        .container { max-width: 1050px; margin: 0 auto; }\n        h1 { color: white; text-align: center; margin-bottom: 20px; font-size: 28px; }\n        #alert-banner { display: none; background: #dc3545; color: white; padding: 15px 20px; border-radius: 12px; margin-bottom: 20px; font-weight: bold; text-align: center; box-shadow: 0 5px 20px rgba(220, 53, 69, 0.5); animation: pulse 1.5s infinite; }\n        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.8; } 100% { opacity: 1; } }\n        .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 25px; }\n        .card { background: white; border-radius: 15px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); text-align: center; transition: transform 0.2s; }\n        .card:hover { transform: translateY(-5px); }\n        .card .label { font-size: 13px; color: #888; text-transform: uppercase; letter-spacing: 1px; }\n        .card .value { font-size: 40px; font-weight: bold; margin: 10px 0; color: #667eea; }\n        .card .unit { font-size: 16px; color: #aaa; }\n        .status-badge { display: inline-block; padding: 6px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; }\n        .status-online { background: #d4edda; color: #155724; }\n        .status-offline { background: #f8d7da; color: #721c24; }\n        .panel { background: white; border-radius: 15px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); margin-bottom: 25px; }\n        .panel h2 { font-size: 18px; margin-bottom: 15px; color: #444; }\n        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }\n        @media (max-width: 768px) { .grid-2 { grid-template-columns: 1fr; } }\n        .controls { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }\n        input[type=\"text\"], input[type=\"number\"] { padding: 10px 14px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; }\n        .btn { padding: 11px 22px; border: none; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; }\n        .btn-on { background: #28a745; color: white; }\n        .btn-on:hover { background: #218838; }\n        .btn-off { background: #dc3545; color: white; }\n        .btn-off:hover { background: #c82333; }\n        .btn-primary { background: #667eea; color: white; }\n        .btn-primary:hover { background: #5568d3; }\n        table { width: 100%; border-collapse: collapse; }\n        th, td { padding: 10px; text-align: left; border-bottom: 1px solid #eee; font-size: 14px; }\n        th { background: #f8f9fa; color: #666; text-transform: uppercase; font-size: 12px; }\n        tr:hover td { background: #f9f9f9; }\n        #log { background: #1e1e1e; color: #0f0; font-family: monospace; padding: 15px; border-radius: 10px; max-height: 180px; overflow-y: auto; font-size: 13px; line-height: 1.6; }\n        #log .error { color: #ff6b6b; }\n        #log .info { color: #6bc5ff; }\n        #log .warn { color: #ffd166; }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>IoT Smart Monitoring & Control</h1>\n        <div id=\"alert-banner\"></div>\n        <div class=\"cards\">\n            <div class=\"card\">\n                <div class=\"label\">Suhu Real-Time</div>\n                <div class=\"value\" id=\"suhu\">--</div>\n                <div class=\"unit\">°C (Batas: <span id=\"display-threshold\">30.0</span>°C)</div>\n            </div>\n            <div class=\"card\">\n                <div class=\"label\">Kelembaban</div>\n                <div class=\"value\" id=\"kelembaban\">--</div>\n                <div class=\"unit\">%</div>\n            </div>\n            <div class=\"card\">\n                <div class=\"label\">Koneksi WebSocket</div>\n                <div class=\"value\" style=\"font-size:20px; margin: 18px 0;\">\n                    <span class=\"status-badge status-offline\" id=\"ws-badge\">DISCONNECTED</span>\n                </div>\n                <div class=\"unit\">Push Real-Time</div>\n            </div>\n        </div>\n        <div class=\"panel\">\n            <h2>Grafik Monitoring Suhu & Kelembaban (Real-Time)</h2>\n            <canvas id=\"sensorChart\" height=\"95\"></canvas>\n        </div>\n        <div class=\"grid-2\">\n            <div class=\"panel\">\n                <h2>Kontrol Perangkat (POST /api/kontrol)</h2>\n                <div class=\"controls\" style=\"margin-bottom: 15px;\">\n                    <button class=\"btn btn-on\" onclick=\"kontrol('lamp','on')\">Nyalakan Lampu</button>\n                    <button class=\"btn btn-off\" onclick=\"kontrol('lamp','off')\">Matikan Lampu</button>\n                </div>\n                <div class=\"controls\">\n                    <label style=\"font-size:13px; font-weight:600;\">X-API-Key:</label>\n                    <input type=\"text\" id=\"api-key-input\" value=\"RAHASIABANGAT123\" style=\"width: 180px;\">\n                    <button class=\"btn btn-primary\" onclick=\"loadInitialData()\">Muat Ulang SQLite</button>\n                </div>\n            </div>\n            <div class=\"panel\">\n                <h2>Batas Suhu Alert (PUT /api/threshold)</h2>\n                <div class=\"controls\">\n                    <input type=\"number\" id=\"threshold-input\" step=\"0.5\" value=\"30.0\" style=\"width: 120px;\">\n                    <button class=\"btn btn-primary\" onclick=\"updateThreshold()\">Simpan Batas (°C)</button>\n                </div>\n                <p style=\"font-size: 12px; color: #777; margin-top: 10px;\">Notifikasi MQTT & banner merah otomatis aktif jika suhu melebihi nilai batas.</p>\n            </div>\n        </div>\n        <div class=\"panel\">\n            <h2>10 Data Sensor Terakhir (Dari Database SQLite)</h2>\n            <table>\n                <thead><tr><th>Waktu Diterima</th><th>Suhu (°C)</th><th>Kelembaban (%)</th></tr></thead>\n                <tbody id=\"history-body\"><tr><td colspan=\"3\" style=\"text-align:center;color:#999;\">Menunggu data...</td></tr></tbody>\n            </table>\n        </div>\n        <div class=\"panel\">\n            <h2>Log Aktivitas Sistem</h2>\n            <div id=\"log\"></div>\n        </div>\n    </div>\n    <script>\n        const API_BASE = '/api';\n        const WS_URL = 'ws://' + window.location.host + '/ws/iot';\n        let historyData = [];\n        function getHeaders() {\n            return { 'Content-Type': 'application/json', 'X-API-Key': document.getElementById('api-key-input').value.trim() };\n        }\n        function log(msg, type = 'info') {\n            const el = document.getElementById('log');\n            const time = new Date().toLocaleTimeString();\n            el.innerHTML += `<div class=\"${type}\">[${time}] ${msg}</div>`;\n            el.scrollTop = el.scrollHeight;\n        }\n        const ctx = document.getElementById('sensorChart').getContext('2d');\n        const sensorChart = new Chart(ctx, {\n            type: 'line',\n            data: {\n                labels: [],\n                datasets: [\n                    { label: 'Suhu (°C)', data: [], borderColor: '#ff6384', backgroundColor: 'rgba(255, 99, 132, 0.15)', borderWidth: 2, tension: 0.3, fill: true },\n                    { label: 'Kelembaban (%)', data: [], borderColor: '#36a2eb', backgroundColor: 'rgba(54, 162, 235, 0.15)', borderWidth: 2, tension: 0.3, fill: true }\n                ]\n            },\n            options: { responsive: true, animation: { duration: 300 }, scales: { y: { beginAtZero: false } } }\n        });\n        function updateChartAndTable() {\n            const recent15 = historyData.slice(-15);\n            sensorChart.data.labels = recent15.map(d => new Date(d.received).toLocaleTimeString());\n            sensorChart.data.datasets[0].data = recent15.map(d => d.suhu);\n            sensorChart.data.datasets[1].data = recent15.map(d => d.kelembaban);\n            sensorChart.update();\n            const tbody = document.getElementById('history-body');\n            if (historyData.length === 0) { tbody.innerHTML = '<tr><td colspan=\"3\" style=\"text-align:center;color:#999;\">Belum ada data di SQLite</td></tr>'; return; }\n            tbody.innerHTML = historyData.slice(-10).reverse().map(d => `<tr><td>${new Date(d.received).toLocaleTimeString()}</td><td><strong>${d.suhu}</strong></td><td>${d.kelembaban}</td></tr>`).join('');\n        }\n        async function loadInitialData() {\n            try {\n                const resSuhu = await fetch(`${API_BASE}/suhu`, { headers: getHeaders() });\n                const jsonSuhu = await resSuhu.json();\n                if (resSuhu.status === 401) { log(`Akses ditolak: ${jsonSuhu.message}`, 'error'); return; }\n                if (jsonSuhu.threshold) { document.getElementById('display-threshold').textContent = jsonSuhu.threshold; document.getElementById('threshold-input').value = jsonSuhu.threshold; }\n                const resHist = await fetch(`${API_BASE}/history`, { headers: getHeaders() });\n                const jsonHist = await resHist.json();\n                if (jsonHist.status === 'success') { historyData = jsonHist.data; updateChartAndTable(); log(`Berhasil memuat ${jsonHist.count} riwayat data dari database SQLite.`, 'info'); }\n            } catch (err) { log(`Gagal memuat data awal: ${err.message}`, 'error'); }\n        }\n        function connectWebSocket() {\n            const ws = new WebSocket(WS_URL);\n            const badge = document.getElementById('ws-badge');\n            ws.onopen = () => { badge.textContent = 'CONNECTED'; badge.className = 'status-badge status-online'; log('WebSocket terhubung ke Node-RED (/ws/iot).', 'info'); };\n            ws.onmessage = (event) => {\n                const msg = JSON.parse(event.data);\n                if (msg.type === 'sensor_update') {\n                    const d = msg.data;\n                    document.getElementById('suhu').textContent = d.suhu;\n                    document.getElementById('kelembaban').textContent = d.kelembaban;\n                    document.getElementById('display-threshold').textContent = msg.threshold;\n                    const banner = document.getElementById('alert-banner');\n                    if (msg.alert) { banner.style.display = 'block'; banner.textContent = `🚨 ${msg.alert_message}`; log(msg.alert_message, 'warn'); } else { banner.style.display = 'none'; }\n                    historyData.push(d);\n                    if (historyData.length > 50) historyData.shift();\n                    updateChartAndTable();\n                }\n            };\n            ws.onclose = () => { badge.textContent = 'RECONNECTING...'; badge.className = 'status-badge status-offline'; setTimeout(connectWebSocket, 3000); };\n        }\n        async function updateThreshold() {\n            const nilai = parseFloat(document.getElementById('threshold-input').value);\n            try {\n                const res = await fetch(`${API_BASE}/threshold`, { method: 'PUT', headers: getHeaders(), body: JSON.stringify({ threshold: nilai }) });\n                const json = await res.json();\n                if (res.ok && json.status === 'success') { document.getElementById('display-threshold').textContent = json.threshold; log(`Batas suhu diperbarui menjadi ${json.threshold}°C`, 'info'); } else { log(`Gagal set threshold (${res.status}): ${json.message}`, 'error'); }\n            } catch (err) { log(`Error threshold: ${err.message}`, 'error'); }\n        }\n        async function kontrol(device, action) {\n            try {\n                const res = await fetch(`${API_BASE}/kontrol`, { method: 'POST', headers: getHeaders(), body: JSON.stringify({ device, action }) });\n                const json = await res.json();\n                if (res.ok && json.status === 'success') { log(`Perintah terkirim: ${device} → ${action}`, 'info'); } else { log(`Gagal kontrol (${res.status}): ${json.message}`, 'error'); }\n            } catch (err) { log(`Error kontrol: ${err.message}`, 'error'); }\n        }\n        loadInitialData();\n        connectWebSocket();\n    </script>\n</body>\n</html>",
        "output": "str",
        "x": 370,
        "y": 260,
        "wires": [["http_resp_general"]]
    },
    {
        "id": "http_get_suhu",
