    {
        "id": "fn_auth_suhu",
        "type": "function",
        "z": "tab_iot_lengkap",
        "name": "Auth + Response Suhu",
        "func": "const VALID_KEY = 'RAHASIABANGAT123';\nconst apiKey = msg.req.headers['x-api-key'];\n\nif (apiKey !== VALID_KEY) {\n    msg.statusCode = 401;\n    msg.payload = { status: 'error', message: 'Unauthorized: X-API-Key tidak valid' };\n    return msg;\n}\n\nvar data = flow.get('lastSensor') || { suhu: null, kelembaban: null, timestamp: null };\nvar threshold = flow.get('tempThreshold') || 30.0;\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    data: data,\n    threshold: threshold,\n    server_time: new Date().toISOString()\n};\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 320,
        "wires": [["http_resp_general"]]
    },
    {
        "id": "http_get_history",
