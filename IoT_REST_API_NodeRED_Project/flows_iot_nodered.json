    {
        "id": "fn_proc_kontrol",
        "type": "function",
        "z": "tab_iot_lengkap",
        "name": "Auth, Validasi & Publish Kontrol",
        "func": "const VALID_KEY = 'RAHASIABANGAT123';\nconst apiKey = msg.req.headers['x-api-key'];\n\nif (apiKey !== VALID_KEY) {\n    msg.statusCode = 401;\n    msg.payload = { status: 'error', message: 'Unauthorized: X-API-Key tidak valid' };\n    return [msg, null];\n}\n\nvar body = msg.payload;\nif (!body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.payload = { status: 'error', message: 'device dan action wajib diisi' };\n    return [msg, null];\n}\n\nvar mqttMsg = { payload: JSON.stringify(body), topic: 'iot/kontrol' };\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    message: 'Perintah terkirim',\n    sent: body\n};\nreturn [msg, mqttMsg];",
