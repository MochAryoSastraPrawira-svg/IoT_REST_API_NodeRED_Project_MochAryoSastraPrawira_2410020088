    {
        "id": "fn_put_threshold",
        "type": "function",
        "z": "tab_iot_lengkap",
        "name": "Auth & Set Threshold Suhu",
        "func": "const VALID_KEY = 'RAHASIABANGAT123';\nconst apiKey = msg.req.headers['x-api-key'];\n\nif (apiKey !== VALID_KEY) {\n    msg.statusCode = 401;\n    msg.payload = { status: 'error', message: 'Unauthorized: X-API-Key tidak valid' };\n    return msg;\n}\n\nvar nilai = parseFloat(msg.payload.threshold);\nif (isNaN(nilai)) {\n    msg.statusCode = 400;\n    msg.payload = { status: 'error', message: 'Field threshold harus berupa angka' };\n    return msg;\n}\n\nflow.set('tempThreshold', nilai);\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    message: 'Batas suhu berhasil diperbarui',\n    threshold: nilai\n};\nreturn msg;",
        "outputs": 1,
        "x": 390,
        "y": 540,
        "wires": [["http_resp_general"]]
    },
    {
        "id": "http_resp_general",
        "type": "http response",
        "z": "tab_iot_lengkap",
        "name": "HTTP Response",
