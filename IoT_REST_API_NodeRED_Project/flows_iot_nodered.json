    {
        "id": "fn_init_db",
        "type": "function",
        "z": "tab_iot_lengkap",
        "name": "Setup Tabel SQLite & Default Threshold",
        "func": "if (flow.get('tempThreshold') === undefined) {\n    flow.set('tempThreshold', 30.0);\n}\nmsg.topic = \"CREATE TABLE IF NOT EXISTS sensor_history (id INTEGER PRIMARY KEY AUTOINCREMENT, suhu REAL, kelembaban REAL, timestamp TEXT, received TEXT);\";\nreturn msg;",
