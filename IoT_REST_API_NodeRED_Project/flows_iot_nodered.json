        "x": 670,
        "y": 60,
        "wires": [[]]
    },
    {
        "id": "mqtt_in_sensor",
        "type": "mqtt in",
        "z": "tab_iot_lengkap",
        "name": "Subscribe Sensor",
        "topic": "iot/sensor",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_cfg",
        "x": 140,
        "y": 160,
        "wires": [["fn_process_sensor"]]
    },
    {
        "id": "fn_process_sensor",
        "type": "function",
        "z": "tab_iot_lengkap",
        "name": "Proses Sensor, Cek Threshold & Siapkan SQL",
        "func": "var data = msg.payload;\ndata.received = new Date().toISOString();\nflow.set('lastSensor', data);\n\nvar threshold = flow.get('tempThreshold') || 30.0;\nvar isAlert = data.suhu > threshold;\n\nvar sqlMsg = {\n    topic: `INSERT INTO sensor_history (suhu, kelembaban, timestamp, received) VALUES (${data.suhu}, ${data.kelembaban}, '${data.timestamp}', '${data.received}');`\n};\n\nvar wsMsg = {\n    payload: JSON.stringify({\n        type: 'sensor_update',\n        data: data,\n        threshold: threshold,\n        alert: isAlert,\n        alert_message: isAlert ? `PERINGATAN! Suhu (${data.suhu}°C) melebihi batas (${threshold}°C)!` : null\n    })\n};\n\nvar alertMqttMsg = null;\nif (isAlert) {\n    alertMqttMsg = {\n        topic: 'iot/alert',\n        payload: JSON.stringify({\n            status: 'WARNING',\n            message: `Suhu tinggi terdeteksi: ${data.suhu}°C (Batas: ${threshold}°C)`,\n            timestamp: data.received\n        })\n    };\n}\n\nreturn [sqlMsg, wsMsg, alertMqttMsg];",
        "outputs": 3,
        "x": 410,
        "y": 160,
        "wires": [["sqlite_insert"], ["ws_out_broadcast"], ["mqtt_out_alert", "debug_alert"]]
    },
    {
        "id": "sqlite_insert",
        "type": "sqlite",
        "z": "tab_iot_lengkap",
        "mydb": "sqlite_db_cfg",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "Simpan ke SQLite",
        "x": 710,
        "y": 120,
        "wires": [[]]
    },
